datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["views"]
}

enum RoleEnum {
  ADMIN
  PLAYER
}

// A round's way to the players: created as a draft, approved by an admin, then published
enum RoundStatus {
  DRAFT
  APPROVED
  PUBLISHED
}

// Who sees a player's or a team's profile photo (others get the initials or the team's letter). A team is ALL or
// TEAMMATES (its own players); ME is a player's only (CHECK in the migration script).
enum PhotoVisibility {
  ALL
  TEAMMATES
  ME
}

enum BelaAnnouncementEnum {
  TWENTY
  FIFTY
  ONE_HUNDRED
  ONE_HUNDRED_FIFTY
  TWO_HUNDRED
}

model Player {
  id              Int       @id @default(autoincrement())
  username        String    @unique @db.VarChar(100)
  password_hash   String
  email           String    @unique @db.VarChar(100)
  player_role     RoleEnum
  first_name      String    @db.VarChar(100)
  last_name       String    @db.VarChar(100)
  birth_date      DateTime? @db.Date // null until a Google sign-up gives it
  // optional; Burza igrača fills it into new ads, and "Dostupan sam" from the profile shows it
  phone           String?   @db.VarChar(30)
  // "Pušiš li?": asked at sign-up after the birth date, changed on the profile. Create Round seats teams with smokers
  // at the smoking tables.
  smoker          Boolean   @default(false)
  // the player has answered it (at sign-up, on the profile, or when the app asks the players who signed up before)
  smoker_answered Boolean   @default(false)
  // false = deactivated by an admin: can't log in, isn't offered for teams or lineups; results and rating stay
  active          Boolean   @default(true)
  // set when an admin deleted the player; the row stays anonymised ("Obrisani igrač"). CHECK: deleted ⇒ inactive
  deleted_at      DateTime?
  created_at      DateTime  @default(now())
  last_updated_at DateTime? @updatedAt

  // Glicko-2 Rating System fields
  rating          Int       @default(1500)  // R - Player rating (mu)
  rating_deviation Float    @default(350.0)   // RD - Rating uncertainty (phi)
  volatility      Float     @default(0.06)    // Sigma - Rating volatility

  // Profile photo: the bytes live in PlayerPhoto, so a Player row never carries them; photo_updated_at is set while
  // there is one and is the version in its address (?v=). The player sets it on Moj profil; an admin may remove it
  // and, with photo_blocked, stop the player from setting a new one.
  photo_updated_at DateTime?
  photo_visibility PhotoVisibility @default(ALL)
  photo_blocked    Boolean         @default(false)

  // NextAuth required fields
  emailVerified DateTime?
  // the Google account's picture: only offered as a profile photo, never shown by itself
  image         String?   @db.Text
  name          String?   @db.VarChar(100)

  // Relationships
  founder1Teams                  Team[]                          @relation("PlayerFounder1")
  founder2Teams                  Team[]                          @relation("PlayerFounder2")
  creatorTeams                   Team[]                          @relation("PlayerCreator")
  teamPlayers                    TeamPlayer[]
  roundPlayers                   RoundPlayer[]
  ratingHistory                  PlayerRatingHistory[]
  marketPosts                    MarketPost[]                    @relation("MarketPostAuthor")
  marketPostsWith                MarketPost[]                    @relation("MarketPostWith")
  sessions                       Session[]
  luciaSessions                  LuciaSession[]
  accounts                       Account[]
  createRoundDrafts              CreateRoundDraft[]
  photo                          PlayerPhoto?
  teamPhotosUpdated              Team[]                          @relation("TeamPhotoUpdater")
  tournamentEntries              TournamentTeam[]                @relation("TournamentRegistrar")
}

// A player's profile photo: a 512×512 WebP or PNG cropped in the browser, up to 512 KB (CHECK in the migration script).
// Read only by GET /api/players/[id]/photo.
model PlayerPhoto {
  player_id Int    @id
  photo     Bytes
  type      String @db.VarChar(20)

  player Player @relation(fields: [player_id], references: [id], onDelete: Cascade)
}

model Session {
  id           String   @id @default(uuid()) @db.Uuid
  sessionToken String?  @unique
  userId       Int
  expires      DateTime
  user         Player   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model LuciaSession {
  id        String   @id @db.Uuid
  userId    Int
  expiresAt DateTime
  player    Player   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                String  @id @default(cuid())
  userId            Int
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user Player @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// A one-day event teams sign up for (Turniri). It is played in Kolos: Kolo N is the tables (Round rows, linked by
// TournamentRound) with round_number N, all on the tournament's date, so the whole tournament is one rating period.
// Kolo 1 is paired at random, the later ones by the standings (Swiss). It starts when Kolo 1 is published; a
// started one takes no sign-ups and can't be cancelled (CHECKs in the migration script).
model Tournament {
  tournament_id      Int       @id @default(autoincrement())
  tournament_name    String    @db.VarChar(100)
  // the day it is played; every Kolo's tables carry it as their round_date
  date               DateTime  @db.Date
  // "HH:MM" (CHECK constraints in the migration script); Okupljanje and Početak, both optional
  gathering_time     String?   @db.VarChar(5)
  start_time         String?   @db.VarChar(5)
  location_name      String?   @db.VarChar(100)
  location_address   String?   @db.VarChar(200)
  location_url       String?   @db.VarChar(500) // a Google Maps share link
  // Broj kola (1-20)
  rounds             Int       @default(9)
  // Partija po kolu: the matches a table plays (1 or 2)
  matches_per_round  Int       @default(2)
  // Zvanja: false = "bez zvanja", only bela (20) is entered
  declarations       Boolean   @default(true)
  // Najveći broj ekipa; null = no limit. Teams over it wait on the waiting list
  max_teams          Int?
  // Kotizacija po igraču in whole euros; 0 = "Bez stresa, bez obveza"
  entry_fee          Int       @default(0)
  rules_url          String?   @db.VarChar(500)
  // the admin's Prijave otvorene; closed by itself when the tournament starts
  registrations_open Boolean   @default(true)
  // when Kolo 1 was published
  started_at         DateTime?
  cancelled_at       DateTime?
  created_at         DateTime  @default(now())

  // Relationships
  tournamentTeams  TournamentTeam[]
  tournamentRounds TournamentRound[]
  teamScore        TeamScore[]
  prizes           TournamentPrize[]
}

// Nagrade: what each place gets, in order (place 1 = first)
model TournamentPrize {
  tournament_id Int
  place         Int
  prize         String @db.VarChar(100)
  description   String @default("") @db.VarChar(200)

  tournament Tournament @relation(fields: [tournament_id], references: [tournament_id], onDelete: Cascade)

  @@id([tournament_id, place])
}

model League {
  league_id        Int       @id @default(autoincrement())
  league_name      String    @db.VarChar(100)
  season           String?   @db.VarChar(20)
  start_date       DateTime? @db.Date
  // after start_date; CHECK constraint added in the migration script
  end_date         DateTime? @db.Date
  // 0 = Monday ... 6 = Sunday; CHECK constraint added in the migration script
  play_day         Int?
  // when its nights start, "HH:MM" (00:00 ... 23:59; CHECK constraint in the migration script); optional. Text, not a
  // Postgres TIME: Prisma reads TIME as a DateTime on 1970-01-01, which a time zone can shift, and a wall-clock time
  // needs no date or zone. A night's own start_time wins over this one.
  start_time       String?   @db.VarChar(5)
  // where its nights are played; all optional. A night's own location wins over this one.
  location_name    String?   @db.VarChar(100)
  location_address String?   @db.VarChar(200)
  location_url     String?   @db.VarChar(500) // a Google Maps share link
  // default "Rounds" in Create Round
  rounds_per_night Int       @default(3)
  // the admins' notes, shown next to Create Round (never in the public league list)
  notes            String    @default("")
  // the smoking tables of the league's last Create Round, offered again the next time (empty: no smoking tables)
  smoking_tables   Int[]     @default([])
  created_at       DateTime  @default(now())

  // Relationships
  leagueTeams  LeagueTeam[]
  leagueRounds LeagueRound[]
  teamScore    TeamScore[]
  nights       LeagueNight[]
  marketPosts  MarketPost[]
  createRoundDrafts CreateRoundDraft[]
  sponsors     LeagueSponsor[]
  sponsorStats SponsorDailyStat[]
}

// A night the league plays (Manage League · Dates). Filled in from the start date, end date and play day when the
// league is created; admins add or remove single nights, and a round created on another date adds its night.
// Players see them in Raspored, and Burza igrača offers only these nights to a team that needs a substitute.
model LeagueNight {
  league_id  Int
  night      DateTime @db.Date
  // this night's own start time, "HH:MM", when it differs from the league's start_time (null: the league's)
  start_time String?  @db.VarChar(5)
  // this night's own location when it is played somewhere else (null location_name: the league's; address and link
  // are then null too)
  location_name    String? @db.VarChar(100)
  location_address String? @db.VarChar(200)
  location_url     String? @db.VarChar(500)

  league League @relation(fields: [league_id], references: [league_id], onDelete: Cascade)

  @@id([league_id, night])
}

// What an admin has set up on Novo kolo for a league tonight, so it survives a reload, a trip to make a new team and
// another computer; each admin has their own. One row per admin and league: the next night overwrites it.
// sitting_out: the teams that don't play, taken when the admin first changes something. A team made inactive later keeps
// playing, one made active stays out until it is switched on, and a team added to the league later plays.
model CreateRoundDraft {
  player_id      Int
  league_id      Int
  // the league night it is for (before 06:00 still the night before, Zagreb time)
  night          DateTime @db.Date
  rounds         Int
  window_size    Int
  smoking_on     Boolean
  smoking_tables Int[]    @default([])
  sitting_out    Int[]    @default([])
  updated_at     DateTime @default(now()) @updatedAt

  player Player @relation(fields: [player_id], references: [id], onDelete: Cascade)
  league League @relation(fields: [league_id], references: [league_id], onDelete: Cascade)

  @@id([player_id, league_id])
  @@index([league_id])
}

enum MarketPostKind {
  SUBSTITUTE // "Treba zamjena": a team needs a player for one league night
  PARTNER // "Traži partnera": a player looks for a partner for a league
  AVAILABLE // "Dostupan": a player is available as a substitute and/or a new partner
}

// An ad in Burza igrača. Everyone sees the open ones, also without logging in, with the phone number to call.
// A substitute ad closes by itself when its night has passed, a partner ad when its league has ended; the
// author (or an admin) closes any ad. A player has at most one open AVAILABLE ad (the profile's "Dostupan sam").
// What each kind needs is checked in the migration script.
model MarketPost {
  id             Int            @id @default(autoincrement())
  kind           MarketPostKind
  // who published it
  player_id      Int
  // SUBSTITUTE and PARTNER
  league_id      Int?
  // SUBSTITUTE: the team that needs a player, the night and the player the substitute plays with (who asks for one)
  team_id        Int?
  night          DateTime?      @db.Date
  with_player_id Int?
  // AVAILABLE: as what
  as_substitute  Boolean        @default(false)
  as_partner     Boolean        @default(false)
  // the note, or the partner ad's text
  note           String         @default("")
  // null on an AVAILABLE ad means the profile's phone number
  phone          String?        @db.VarChar(30)
  created_at     DateTime       @default(now())
  closed_at      DateTime?

  player     Player  @relation("MarketPostAuthor", fields: [player_id], references: [id], onDelete: Cascade)
  withPlayer Player? @relation("MarketPostWith", fields: [with_player_id], references: [id], onDelete: SetNull)
  league     League? @relation(fields: [league_id], references: [league_id], onDelete: Cascade)
  team       Team?   @relation(fields: [team_id], references: [team_id], onDelete: Cascade)

  @@index([closed_at, kind])
}

// A sponsor on the admin's one list (Sponzori). Each league picks its sponsors from it (LeagueSponsor); their logos
// slide along Početna on the phone and along the bottom of a live round on the admin's computer. All sponsors are
// equal: there is no main sponsor.
model Sponsor {
  id         Int      @id @default(autoincrement())
  name       String   @db.VarChar(100)
  // the sponsor's page, opened from its card ("Otvori stranicu"); http(s) only
  url        String?  @db.VarChar(500)
  // shown to the players on its card; up to 80 characters (CHECK in the migration script)
  message    String   @default("") @db.VarChar(80)
  // what is under the logo: "none" (just the logo) or "dark" (the black plate, for a light logo); CHECK in the
  // migration script
  background String   @default("none") @db.VarChar(10)
  // the logo itself, shrunk to at most 512 px by the admin's browser: PNG, JPEG or WebP, up to 1 MB
  logo       Bytes
  logo_type  String   @db.VarChar(20)
  logo_width  Int
  logo_height Int
  created_at DateTime @default(now())
  // also the logo's version in its address, so a changed logo isn't served from the cache
  updated_at DateTime @default(now()) @updatedAt

  leagues LeagueSponsor[]
  stats   SponsorDailyStat[]
}

// A league's sponsors in the order the admin arranged them (they slide in this order)
model LeagueSponsor {
  league_id  Int
  sponsor_id Int
  position   Int

  league  League  @relation(fields: [league_id], references: [league_id], onDelete: Cascade)
  sponsor Sponsor @relation(fields: [sponsor_id], references: [id], onDelete: Cascade)

  @@id([league_id, sponsor_id])
}

// For the sponsors: how often their logo was shown and their page opened, per league and day. A view is one opening
// of Početna or of a live round with the logo on it; nothing about who looked is kept.
model SponsorDailyStat {
  sponsor_id Int
  league_id  Int
  day        DateTime @db.Date
  views      Int      @default(0)
  clicks     Int      @default(0)

  sponsor Sponsor @relation(fields: [sponsor_id], references: [id], onDelete: Cascade)
  league  League  @relation(fields: [league_id], references: [league_id], onDelete: Cascade)

  @@id([sponsor_id, league_id, day])
  @@index([league_id])
}

model Team {
  team_id         Int       @id @default(autoincrement())
  team_name       String    @unique @db.VarChar(100)
  founder_id1     Int?
  founder_id2     Int?
  creator_id      Int?
  created_at      DateTime  @default(now())
  last_updated_at DateTime? @updatedAt
  // The team's photo, set by any of its players (bytes in TeamPhoto, as for a player); photo_updated_by is the player
  // who last changed it
  photo_updated_at DateTime?
  photo_updated_by Int?
  photo_visibility PhotoVisibility @default(ALL)
  photo_blocked    Boolean         @default(false)

  // Relationships
  photoUpdater    Player?          @relation("TeamPhotoUpdater", fields: [photo_updated_by], references: [id], onDelete: SetNull)
  photo           TeamPhoto?
  founder1        Player?          @relation("PlayerFounder1", fields: [founder_id1], references: [id], onDelete: SetNull)
  founder2        Player?          @relation("PlayerFounder2", fields: [founder_id2], references: [id], onDelete: SetNull)
  creator         Player?          @relation("PlayerCreator", fields: [creator_id], references: [id], onDelete: SetNull)
  teamPlayers     TeamPlayer[]
  tournamentTeams TournamentTeam[]
  leagueTeams     LeagueTeam[]
  roundsAsTeam1   Round[]          @relation("RoundTeam1")
  roundsAsTeam2   Round[]          @relation("RoundTeam2")
  teamScore       TeamScore[]
  roundPlayers    RoundPlayer[]
  marketPosts     MarketPost[]
}

model TeamPhoto {
  team_id Int    @id
  photo   Bytes
  type    String @db.VarChar(20)

  team Team @relation(fields: [team_id], references: [team_id], onDelete: Cascade)
}

model TeamScore {
  id               Int  @id @default(autoincrement())
  team_id          Int
  league_id        Int?
  tournament_id    Int?
  rounds_played    Int  @default(0)
  wins             Int  @default(0)
  draws            Int  @default(0)
  losses           Int  @default(0)
  point_difference Int  @default(0)
  score            Int  @default(0)

  // Relationships
  team       Team        @relation(fields: [team_id], references: [team_id], onDelete: Cascade)
  league     League?     @relation(fields: [league_id], references: [league_id], onDelete: Cascade)
  tournament Tournament? @relation(fields: [tournament_id], references: [tournament_id], onDelete: Cascade)

  // This model is additionaly modified in the migration script to add a constraint of
  // either league_id or tournament_id not being null!
  // CHECK if this constraint is removed after every modification of TeamScore model!
  @@unique([team_id, league_id])
}

model TeamPlayer {
  team_id   Int
  player_id Int

  team   Team   @relation(fields: [team_id], references: [team_id], onDelete: Cascade)
  player Player @relation(fields: [player_id], references: [id], onDelete: Cascade)

  @@id([team_id, player_id])
}

// A team's entry in a tournament: in it, or on its waiting list. The waiting list goes in the order the teams signed up
// (registered_at); when a team leaves, the first one waiting comes in. registered_by: the player who signed it up
// (null: an admin added it).
model TournamentTeam {
  tournament_id Int
  team_id       Int
  status        TournamentEntryStatus @default(REGISTERED)
  registered_at DateTime              @default(now())
  registered_by Int?

  tournament Tournament @relation(fields: [tournament_id], references: [tournament_id], onDelete: Cascade)
  team       Team       @relation(fields: [team_id], references: [team_id], onDelete: Cascade)
  registrar  Player?    @relation("TournamentRegistrar", fields: [registered_by], references: [id], onDelete: SetNull)

  @@id([tournament_id, team_id])
  @@index([team_id])
}

enum TournamentEntryStatus {
  REGISTERED
  WAITING
}

model LeagueTeam {
  league_id Int
  team_id   Int
  // inactive teams stay in the league and its standings but are not signed in by default when a round is created
  active    Boolean @default(true)

  league League @relation(fields: [league_id], references: [league_id], onDelete: Cascade)
  team   Team   @relation(fields: [team_id], references: [team_id], onDelete: Cascade)

  @@id([league_id, team_id])
}

model Round {
  id            Int       @id @default(autoincrement())
  round_number  Int?
  round_date    DateTime? @default(now()) @db.Date
  team1_id      Int
  team2_id      Int
  team1_wins    Int       @default(0)
  team2_wins    Int       @default(0)
  open          Boolean   @default(true)
  active        Boolean   @default(false)
  table_number  Int?
  // smoking is allowed at this table (picked in Create Round); it stays with the table when an admin re-pairs it
  smoking_table Boolean   @default(false)
  // smokers on each team's roster when it was seated here; the smoking rotation counts from these
  team1_smokers Int       @default(0)
  team2_smokers Int       @default(0)
  // Novo kolo creates a night's rounds as DRAFT; an admin approves them and publishes the approved ones (Upravljanje
  // ligom · Skica). Until then only admins see them: players, the standings and every public page see PUBLISHED rounds.
  // Every table of a round (a round number on a night) has the same status.
  status        RoundStatus @default(DRAFT)
  // when it was published; null for an unpublished round and for the rounds from before publishing (CHECK constraint
  // in the migration script: only a published round has it)
  published_at  DateTime?
  // a round not published yet is Skica A, B, C… by its place in the batch Novo kolo created (1 = A); its
  // round_number only keeps its tables together until publishing numbers it after the league's last published round
  // (CHECK constraint in the migration script: only an unpublished round has it)
  draft_order   Int?
  // the matches the table plays: 2 in a league, 1 or 2 in a tournament (its Partija po kolu; CHECK in the migration)
  matches_per_round Int @default(2)
  // zvanja are entered at the table; false (a tournament "bez zvanja"): only bela (20)
  declarations      Boolean @default(true)

  team1            Team             @relation("RoundTeam1", fields: [team1_id], references: [team_id], onDelete: Cascade)
  team2            Team              @relation("RoundTeam2", fields: [team2_id], references: [team_id], onDelete: Cascade)
  matches          Match[]
  ongoingMatches   OngoingMatch[]
  tournamentRounds TournamentRound[]
  leagueRounds     LeagueRound[]
  roundPlayers     RoundPlayer[]
}

// A player's rating after each league night they played (Glicko-2, one rating period per night). Rewritten by
// every rating replay; the newest row matches the player's current rating.
model PlayerRatingHistory {
  player_id        Int
  night            DateTime @db.Date
  rating           Int
  rating_deviation Float
  // the rating change that night
  change           Int
  // rated rounds played that night
  rounds           Int

  player Player @relation(fields: [player_id], references: [id], onDelete: Cascade)

  @@id([player_id, night])
}

// The two players of each team who play a round (picked on Start Game); their ratings change with its result.
// A finished round without one gets the team's roster saved here before the roster changes (freezeLineups.ts), and
// an old round's two rosters can share a player, so the key has the team too (a picked lineup never does that).
model RoundPlayer {
  round_id  Int
  player_id Int
  team_id   Int

  round  Round  @relation(fields: [round_id], references: [id], onDelete: Cascade)
  player Player @relation(fields: [player_id], references: [id], onDelete: Cascade)
  team   Team   @relation(fields: [team_id], references: [team_id], onDelete: Cascade)

  @@id([round_id, team_id, player_id])
  @@index([team_id])
}

model TournamentRound {
  tournament_id Int
  round_id      Int

  tournament Tournament @relation(fields: [tournament_id], references: [tournament_id], onDelete: Cascade)
  round      Round      @relation(fields: [round_id], references: [id], onDelete: Cascade)

  @@id([tournament_id, round_id])
  @@index([round_id])
}

model LeagueRound {
  league_id Int
  round_id  Int

  league League @relation(fields: [league_id], references: [league_id], onDelete: Cascade)
  round  Round  @relation(fields: [round_id], references: [id], onDelete: Cascade)

  @@id([league_id, round_id])
}

model Match {
  id                 Int       @id @default(autoincrement())
  round_id           Int?
  player_pair1_score Int       @default(0)
  player_pair2_score Int       @default(0)
  score_threshold    Int?
  start_time         DateTime?
  end_time           DateTime?
  match_date         DateTime? @default(now()) @db.Date

  round          Round?          @relation(fields: [round_id], references: [id], onDelete: SetNull)
  belaResults    BelaResult[]
}

model OngoingMatch {
  id                     Int       @id @default(autoincrement())
  round_id               Int?
  player_pair1_score     Int       @default(0)
  player_pair2_score     Int       @default(0)
  score_threshold        Int?
  start_time             DateTime? @default(dbgenerated("CURRENT_TIME")) @db.Time()
  end_time               DateTime? @db.Time()
  match_date             DateTime? @default(now()) @db.Date

  round       Round?              @relation(fields: [round_id], references: [id], onDelete: SetNull)
  belaResults OngoingBelaResult[]
}

model BelaResult {
  result_id                        Int                     @id @default(autoincrement())
  match_id                         Int
  player_pair1_game_points         Int                     @default(0)
  player_pair2_game_points         Int                     @default(0)
  player_pair1_announcement_points Int                     @default(0)
  player_pair2_announcement_points Int                     @default(0)
  player_pair1_total_points        Int                     @default(0)
  player_pair2_total_points        Int                     @default(0)
  // 1 = team1 (round.team1), 2 = team2 (round.team2); CHECK constraint added in the migration script
  trump_caller_team                Int?
  pass                             Boolean                 @default(false)
  complete_victory                 Boolean                 @default(false)

  match                   Match                    @relation(fields: [match_id], references: [id], onDelete: Cascade)
  belaPlayerAnnouncements BelaPlayerAnnouncement[]
}

model OngoingBelaResult {
  result_id                        Int                     @id @default(autoincrement())
  match_id                         Int
  player_pair1_game_points         Int                     @default(0)
  player_pair2_game_points         Int                     @default(0)
  player_pair1_announcement_points Int                     @default(0)
  player_pair2_announcement_points Int                     @default(0)
  player_pair1_total_points        Int                     @default(0)
  player_pair2_total_points        Int                     @default(0)
  // 1 = team1 (round.team1), 2 = team2 (round.team2); CHECK constraint added in the migration script
  trump_caller_team                Int?
  pass                             Boolean                 @default(false)
  complete_victory                 Boolean                 @default(false)

  match                   OngoingMatch                    @relation(fields: [match_id], references: [id], onDelete: Cascade)
  belaPlayerAnnouncements OngoingBelaPlayerAnnouncement[]
}

model BelaPlayerAnnouncement {
  announcement_id   Int                  @id @default(autoincrement())
  result_id         Int
  // 1 = team1 (round.team1), 2 = team2 (round.team2); CHECK constraint added in the migration script
  team              Int
  announcement_type BelaAnnouncementEnum

  result BelaResult @relation(fields: [result_id], references: [result_id], onDelete: Cascade)
}

model OngoingBelaPlayerAnnouncement {
  announcement_id   Int                  @id @default(autoincrement())
  result_id         Int
  // 1 = team1 (round.team1), 2 = team2 (round.team2); CHECK constraint added in the migration script
  team              Int
  announcement_type BelaAnnouncementEnum

  result OngoingBelaResult @relation(fields: [result_id], references: [result_id], onDelete: Cascade)
}

// Failed logins per account from any address, so every serverless instance sees the same count (accountLimiting.ts).
// The key is "player:<id>", or "login:<name>" for a name with no account.
model LoginFailure {
  key           String   @id @db.VarChar(200)
  count         Int
  first_failure DateTime

  @@index([first_failure])
}
